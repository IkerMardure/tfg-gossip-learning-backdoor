\addvspace {10pt}
\contentsline {figure}{\numberline {1.1}{\ignorespaces Structural comparison between the centralized orchestrator dependency in standard FL and the peer-to-peer topology of DFL.}}{2}{figure.1.1}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Centralized Federated Learning}}}{2}{subfigure.1.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Decentralized Federated Learning}}}{2}{subfigure.1.2}%
\addvspace {10pt}
\contentsline {figure}{\numberline {2.1}{\ignorespaces The standard FL training cycle. The process operates in four iterative steps: (1) broadcasting the global model parameters, (2) executing local optimization on private client data, (3) transmitting the computed parameter updates back to the central server, and (4) aggregating the localized updates to synthesize the new global model state.}}{6}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces The standard DFL training cycle. The process operates in three continuous, peer-to-peer steps without a central orchestrator: (1) executing local optimization independently on private data, (2) exchanging the updated models directly with topological neighbors, and (3) aggregating the received peer models to compute a new localized consensus state.}}{8}{figure.2.2}%
\addvspace {10pt}
\contentsline {figure}{\numberline {3.1}{\ignorespaces Adversarial placement configurations within an 8-node Stochastic Block Model (SBM) topology. The compromised node is highlighted in red, contrasting a peripheral node isolated within a local community (a) against a gateway node controlling the structural bottleneck connection (b).}}{15}{figure.3.1}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Gateway Attacker (Node 3)}}}{15}{subfigure.1.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Peripheral Attacker (Node 0)}}}{15}{subfigure.1.2}%
